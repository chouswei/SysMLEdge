{
  "name": "sysmledge",
  "version": "0.1.0",
  "private": true,
  "description": "SysMLEdge — SysML SSOT + GQL via MemNet. P1 Foam proof scaffolding (gold + import + live TCP floor). Proof not executed. Engine is MemNet, not Kuzu. Not ready to serve real projects.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sysmledge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "mcp": "tsx src/mcp/main.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "foam:import": "bash scripts/foam-import.sh",
    "m1:smoke": "bash scripts/m1-smoke.sh",
    "foam:gold": "tsx src/cli.ts gold",
    "proof": "tsx src/cli.ts proof",
    "head-to-head": "tsx src/cli.ts head-to-head",
    "memnet:check": "tsx src/cli.ts memnet-check"
  },
  "keywords": [
    "sysml",
    "gql",
    "memnet",
    "mcp",
    "sysmledge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chouswei/SysMLEdge.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
